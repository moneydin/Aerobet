rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (
          (request.auth.token.get('email', '').lower() == "douglasborges223@gmail.com") ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == "admin")
        );
    }

    function isDocOwner() {
      return isAuthenticated() && resource != null && (request.auth.uid == resource.data.get('uid', ''));
    }

    function isValidUser(data) {
      return (data.get('uid', '') is string || !('uid' in data)) && 
             (data.get('balance', 0) is number || !('balance' in data));
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId) || isAuthenticated();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /bets/{betId} {
      allow read: if true;
      allow create: if isAuthenticated() || true;
      allow update: if isAuthenticated() || true;
      allow delete: if isAuthenticated() || true;
    }

    match /chat/{msgId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /rounds/{roundId} {
      allow read: if true;
      allow write: if true;
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }
    
    match /custom_skins/{skinId} {
      allow read: if true;
      allow write: if true;
    }

    match /rooms/{roomId} {
      allow read: if true;
      allow write: if true;
    }

    match /competitions/{compId} {
      allow read: if true;
      allow write: if true;
    }

    match /cabines/{cabineId} {
      allow read, write: if true;
      match /{document=**} {
        allow read, write: if true;
      }
    }

    match /test/{testId} {
      allow read, write: if true;
    }
  }
}
