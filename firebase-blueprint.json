{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Stores user balance, stats, and profile info",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "username": { "type": "string" },
        "balance": { "type": "number" },
        "freeFlights": { "type": "number" },
        "totalRounds": { "type": "number" },
        "maxMult": { "type": "number" },
        "clubeMember": { "type": "boolean" },
        "clubeFlightsCount": { "type": "number" },
        "avatar": { "type": "string" }
      },
      "required": ["uid", "username", "balance"]
    },
    "Bet": {
      "title": "Game Bet",
      "description": "Stores a bet made by a user in a round",
      "type": "object",
      "properties": {
        "roundId": { "type": "string" },
        "uid": { "type": "string" },
        "username": { "type": "string" },
        "amount": { "type": "number" },
        "multiplier": { "type": "number" },
        "cashedOut": { "type": "boolean" },
        "profit": { "type": "number" },
        "timestamp": { "type": "number" }
      },
      "required": ["roundId", "uid", "amount"]
    },
    "Chat": {
      "title": "Chat Message",
      "description": "Stores a chat message sent by a user",
      "type": "object",
      "properties": {
        "user": { "type": "string" },
        "message": { "type": "string" },
        "timestamp": { "type": "number" },
        "role": { "type": "string" },
        "uid": { "type": "string" }
      },
      "required": ["user", "message", "timestamp", "uid"]
    },
    "Round": {
      "title": "Game Round Result",
      "description": "Stores the crash point and seeds of a finished round",
      "type": "object",
      "properties": {
        "multiplier": { "type": "number" },
        "color": { "type": "string" },
        "hash": { "type": "string" },
        "serverSeed": { "type": "string" },
        "clientSeed": { "type": "string" },
        "roundId": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["multiplier", "roundId", "timestamp"]
    },
    "Room": {
      "title": "Competition Room",
      "description": "Stores AeroFantasy rooms and tournaments",
      "type": "object",
      "properties": {
        "roomNumber": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "currentPlayers": { "type": "number" },
        "maxPlayers": { "type": "number" },
        "totalFlights": { "type": "number" },
        "entryFee": { "type": "number" },
        "prizePool": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["name", "category", "maxPlayers", "totalFlights"]
    },
    "Cabine": {
      "title": "Cabine Session",
      "description": "Stores co-op pilot and copilot shared bankroll sessions",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "password": { "type": "string" },
        "totalBankroll": { "type": "number" },
        "currentBalance": { "type": "number" },
        "pilotName": { "type": "string" },
        "copilotName": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["name", "totalBankroll", "currentBalance", "pilotName", "status"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/bets/{betId}": {
      "schema": "Bet",
      "description": "All game bets"
    },
    "/chat/{msgId}": {
      "schema": "Chat",
      "description": "Chat messages"
    },
    "/rounds/{roundId}": {
      "schema": "Round",
      "description": "Historical game round results"
    },
    "/settings/{settingId}": {
      "schema": "object",
      "description": "System settings like RTP"
    },
    "/custom_skins/{skinId}": {
      "schema": "object",
      "description": "Custom user skins"
    },
    "/rooms/{roomId}": {
      "schema": "Room",
      "description": "AeroFantasy Competition Rooms"
    },
    "/cabines/{cabineId}": {
      "schema": "Cabine",
      "description": "Co-op shared bankroll cabine sessions"
    }
  }
}
